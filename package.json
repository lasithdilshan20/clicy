{
  "name": "clicy",
  "version": "1.0.0-beta.1",
  "description": "Cypress-based CLI automation tool with REPL",
  "main": "dist/cli/repl.js",
  "bin": {
    "clicy": "dist/bin/clicy.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/clicy.git"
  },
  "homepage": "https://github.com/yourusername/clicy",
  "bugs": {
    "url": "https://github.com/yourusername/clicy/issues"
  },
  "files": [
    "dist",
    "bin",
    "cli",
    "commands",
    "utils",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/bin/clicy.js",
    "dev": "ts-node cli/repl.ts",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "clicy:server": "ts-node cli/server.ts",
    "clicy:test": "cypress open --e2e --browser chrome",
    "clicy:start": "ts-node start.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "postinstall": "node scripts/setup.js"
  },
  "keywords": [
    "cypress",
    "cli",
    "automation",
    "testing",
    "repl"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cypress": "14.4.1",
    "express": "^4.18.2",
    "repl": "^0.1.3",
    "ts-node": "^10.9.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.11.9",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^4.9.3"
  }
}
